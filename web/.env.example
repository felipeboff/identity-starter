# Copy to web/.env. Same client IDs as GITHUB_CLIENT_ID and GOOGLE_CLIENT_ID in the API .env
# Shown in the title and the sidebar; also prefixes what the app keeps in the browser
VITE_APP_NAME="Identity Starter"
VITE_GITHUB_CLIENT_ID="replace-with-github-client-id"
VITE_GOOGLE_CLIENT_ID="replace-with-id.apps.googleusercontent.com"
