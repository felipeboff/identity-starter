# Copy to .env and replace every "replace-with-..." value.

# ── App ──────────────────────────────────────────────────────────────
# develop | test | prod
NODE_ENV="develop"
PORT="3000"
# Number of proxies in front of the app (0 when it is exposed directly)
TRUST_PROXY="0"
# debug | info | warn | error
LOG_LEVEL="info"

# ── Errors ───────────────────────────────────────────────────────────
# Optional; leave unset to turn Sentry off. Unexpected errors (500s) and crashes go there. Locally,
# docker compose up starts Bugsink: open http://localhost:8000 (admin / admin), create a project and
# paste its DSN here
# SENTRY_DSN="http://<project-key>@localhost:8000/1"

# ── Database ─────────────────────────────────────────────────────────
# docker compose up -d starts this Mongo
MONGO_URL="mongodb://localhost:27017/resolve-hub?replicaSet=rs0"

# ── Cache ────────────────────────────────────────────────────────────
# docker compose up -d starts this Redis; it keeps the rate limit counters
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# ── Web app ──────────────────────────────────────────────────────────
# Base URL of the front end; e-mail links point to <APP_URL>/reset-password and /verify-email
APP_URL="http://localhost:5173"
# Origins allowed to call the API from a browser, comma-separated
CORS_ORIGINS="http://localhost:5173"

# ── E-mail ───────────────────────────────────────────────────────────
# log (prints the link, for development) | mailersend
MAILER="log"
# Must belong to a domain verified in MailerSend
MAIL_FROM_EMAIL="no-reply@example.com"
MAIL_FROM_NAME="Resolve Hub"
# https://app.mailersend.com/api-tokens
MAILERSEND_API_KEY="replace-with-your-mailersend-key"

# ── OAuth: GitHub ────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-the-40-character-github-client-secret"
# Must be one of the redirect URIs registered in the OAuth App
GITHUB_REDIRECT_URI="http://localhost:5173/auth/github/callback"

# ── OAuth: Google ────────────────────────────────────────────────────
# https://console.cloud.google.com/auth/clients → Web application
GOOGLE_CLIENT_ID="replace-with-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-the-40-character-google-client-secret"
# Must match an authorized redirect URI exactly, and the one used to get the code
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
